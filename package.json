{
  "name": "mesa-movil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:whisper-fixtures": "vitest run src/games/hablaya/whisperSpanish.integration.test.ts",
    "test:watch": "vitest",
    "fixtures:hablaya": "python3 scripts/generate-hablaya-fixtures.py",
    "preview": "vite preview",
    "typecheck:server": "npm --prefix server run typecheck"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wavefile": "^11.0.0"
  },
  "description": "Mesa Móvil — juegos de fiesta en el navegador"
}
