# Opción A (recomendada): URL ya resuelta de Railway.
# En Railway → Redis → Variables → copia el VALOR de REDIS_URL
# (algo como redis://default:xxxx@host.railway.app:6379), NO la plantilla ${{...}}.
REDIS_URL=

# Opción B: piezas sueltas de Railway (si no pegas REDIS_URL).
REDISHOST=
REDISPORT=
REDISUSER=
REDIS_PASSWORD=
